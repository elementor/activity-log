<?xml version="1.0"?>
<ruleset name="WordPress.Elementor">
	<description>Elementor Activity Log Coding Standard</description>

	<arg value="ps" />
	<arg name="parallel" value="8" />

	<config name="text_domain" value="aryo-activity-log" />
	<config name="minimum_wp_version" value="6.0" />

	<exclude-pattern>assets/</exclude-pattern>
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>tmp/</exclude-pattern>
	<exclude-pattern>build/</exclude-pattern>
	<exclude-pattern>node_modules/</exclude-pattern>
	<exclude-pattern>tests/</exclude-pattern>
	<exclude-pattern>aryo-activity-log/</exclude-pattern>

	<!--
		Remaining Security sniffs are warnings until nonce/sanitization debt is resolved.
		EscapeOutput is an error so unescaped output (including __()) fails CI.
	-->
	<rule ref="WordPress.Security">
		<type>warning</type>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<type>error</type>
	</rule>

	<rule ref="WordPress.WP.DeprecatedFunctions" />

	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/-" />
		</properties>
	</rule>
</ruleset>
